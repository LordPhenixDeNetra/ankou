cli-version = { $app } { $version } (protocol { $protocol })
cli-init-written = Configuration written to { $path }. Public key to give to the server: { $public_key }
cli-init-exists = { $path } already exists and was not overwritten.
cli-config-invalid = Invalid configuration in { $path }: { $detail }
cli-config-permissions = Warning: { $path } is readable by other users. Run: chmod 600 { $path }
cli-status-connecting = Connecting to { $server }…
cli-status-connected = Connected to { $server }. Disconnect with: ankou-cli disconnect
cli-status-reconnecting = Connection lost, new attempt { $attempt }…
cli-status-disconnected = Disconnected.
error-tunnel-permission = The ankoud service lacks administrator rights: it must run as root (sudo systemctl restart ankoud).
error-tunnel-unavailable = WireGuard is not available on this system ({ $detail }).
error-server-unreachable = The server { $server } is not answering.
error-profile-missing = No saved configuration: run ankou-cli connect --config <file>.
error-firewall-unavailable = The firewall (nftables) is unavailable, so the kill switch refuses to connect: sudo apt install nftables ({ $detail })
error-internal = Internal error: { $detail }
admin-invite-created = Invitation created (valid until { $expires }): { $code }
admin-server-added = Server { $name } added. Node token, shown only once: { $token }
admin-server-row = { $name } — { $endpoint } — { $country }, { $city } — { $state }
admin-user-row = { $email } — { $state }
admin-device-row = { $id } — { $name } — { $ipv4 } — { $email }
admin-state-active = active
admin-state-disabled = disabled
admin-user-updated = User { $email } updated.
admin-device-revoked = Device { $id } revoked.
admin-not-found = Item not found.
admin-error = Error: { $detail }
cli-register-done = Account created for { $email }. Next: ankou-cli enroll --name <device> --out <file>
cli-login-done = Signed in as { $email }.
cli-password = Password:
cli-password-again = Password (again):
cli-password-mismatch = The two passwords differ.
cli-server-row = { $name } — { $city }, { $country } ({ $endpoint })
cli-enroll-done = Configuration written to { $path } (address { $address }, server { $server }). Connect with: sudo ankou-cli connect --config { $path }
cli-no-server = No VPN server is available yet.
cli-unknown-server = Unknown server: { $name }. List them with: ankou-cli servers
cli-session-missing = No session: run `ankou-cli login`.
cli-session-expired = Session expired: sign in again with `ankou-cli login`.
cli-api-error = The server refused the request ({ $code }): { $detail }
cli-network-error = Cannot reach the API: { $detail }
cli-local-error = Local error: { $detail }
cli-status-connected-since = Connected to { $server } for { $since }.
cli-daemon-missing = The ankoud service is not running: sudo systemctl enable --now ankoud
cli-daemon-denied = Access to the service denied: sudo usermod -aG ankou $USER, then log in again.
cli-daemon-incompatible = The ankoud service speaks protocol { $version }: update ankou-cli and ankoud together.
cli-daemon-error = Error talking to the ankoud service: { $detail }
cli-still-trying = Still trying to connect; follow with ankou-cli status.
cli-autoconnect-on = Automatic connection at startup enabled.
cli-autoconnect-off = Automatic connection at startup disabled.
