cli-version = { $app } { $version } (protocole { $protocol })
cli-init-written = Configuration écrite dans { $path }. Clé publique à donner au serveur : { $public_key }
cli-init-exists = { $path } existe déjà et n'a pas été écrasé.
cli-config-invalid = Configuration invalide dans { $path } : { $detail }
cli-config-permissions = Attention : { $path } est lisible par d'autres utilisateurs. Lancez : chmod 600 { $path }
cli-status-connecting = Connexion à { $server }…
cli-status-connected = Connecté à { $server }. Ctrl+C pour se déconnecter.
cli-status-reconnecting = Connexion perdue, nouvelle tentative { $attempt }…
cli-status-disconnected = Déconnecté.
error-tunnel-permission = Des droits administrateur sont nécessaires : lancez la commande avec sudo.
error-tunnel-unavailable = WireGuard n'est pas disponible sur ce système ({ $detail }).
error-server-unreachable = Le serveur { $server } ne répond pas.
error-profile-missing = Aucune configuration enregistrée : lancez ankou-cli connect --config <fichier>.
error-internal = Erreur interne : { $detail }
admin-invite-created = Invitation créée (valable jusqu'au { $expires }) : { $code }
admin-server-added = Serveur { $name } ajouté. Jeton du node, affiché une seule fois : { $token }
admin-server-row = { $name } — { $endpoint } — { $country }, { $city } — { $state }
admin-user-row = { $email } — { $state }
admin-device-row = { $id } — { $name } — { $ipv4 } — { $email }
admin-state-active = actif
admin-state-disabled = désactivé
admin-user-updated = Utilisateur { $email } mis à jour.
admin-device-revoked = Appareil { $id } révoqué.
admin-not-found = Élément introuvable.
admin-error = Erreur : { $detail }
cli-register-done = Compte créé pour { $email }. Ensuite : ankou-cli enroll --name <appareil> --out <fichier>
cli-login-done = Connecté en tant que { $email }.
cli-password = Mot de passe :
cli-password-again = Mot de passe (confirmation) :
cli-password-mismatch = Les deux mots de passe diffèrent.
cli-server-row = { $name } — { $city }, { $country } ({ $endpoint })
cli-enroll-done = Configuration écrite dans { $path } (adresse { $address }, serveur { $server }). Connexion : sudo ankou-cli connect --config { $path }
cli-no-server = Aucun serveur VPN n'est encore disponible.
cli-unknown-server = Serveur inconnu : { $name }. Liste : ankou-cli servers
cli-session-missing = Pas de session : lancez `ankou-cli login`.
cli-session-expired = Session expirée : reconnectez-vous avec `ankou-cli login`.
cli-api-error = Le serveur a refusé la requête ({ $code }) : { $detail }
cli-network-error = API injoignable : { $detail }
cli-local-error = Erreur locale : { $detail }
